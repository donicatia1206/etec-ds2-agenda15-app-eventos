<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppCadastroEventos.Views.ResumoEventoPage"
             Title="Resumo do Evento Gourmet"
             BackgroundColor="#F4F4F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- CABEÇALHO DO EVENTO -->
            <Frame BackgroundColor="#1E293B" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Nome}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="{Binding TipoEvento}" FontSize="14" TextColor="#CBD5E1" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- FICHA TÉCNICA DE INSUMOS -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ficha Técnica &amp; Insumos (300 Pessoas)" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                    <BoxView HeightRequest="1" Color="#E2E8F0" />
                    
                    <Label Text="{Binding QtdCamaraoSeteBarbasKg, StringFormat='• Camarão Sete Barbas (Volante): {0:F1} kg'}" TextColor="#334155" />
                    <Label Text="{Binding QtdMassaFiloKg, StringFormat='• Massa Filo (Lírio): {0:F1} kg'}" TextColor="#334155" />
                    <Label Text="{Binding QtdFiletMignonKg, StringFormat='• Filet Mignon (Prato Principal): {0:F1} kg'}" TextColor="#334155" />
                    <Label Text="{Binding QtdShitakeFrescoKg, StringFormat='• Cogumelo Shitake: {0:F1} kg'}" TextColor="#334155" />
                    <Label Text="{Binding QtdFunghiSecchiKg, StringFormat='• Funghi Secchi: {0:F1} kg'}" TextColor="#334155" />
                    <Label Text="{Binding QtdQueijoGorgonzolaKg, StringFormat='• Queijo Gorgonzola (Abacaxi): {0:F1} kg'}" TextColor="#334155" />
                </VerticalStackLayout>
            </Frame>

            <!-- RESUMO FINANCEIRO E MARGEM DO CHEF -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Demonstrativo Orçamentário" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <Label Text="{Binding CustoEquipeEMaoDeObra, StringFormat='Equipe &amp; Mão de Obra: {0:C}'}" TextColor="#475569" />
                    <Label Text="{Binding CustoLogisticaEGas, StringFormat='Logística &amp; Estrutura: {0:C}'}" TextColor="#475569" />
                    <Label Text="{Binding CustoTotal, StringFormat='Custo Total de Produção: {0:C}'}" TextColor="#B91C1C" FontAttributes="Bold" />
                    
                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <Label Text="{Binding LucroLiquidoChef, StringFormat='Lucro Líquido do Chef (45%): {0:C}'}" TextColor="#15803D" FontAttributes="Bold" />
                    <Label Text="{Binding ValorFinalOrcamento, StringFormat='Valor Total ao Cliente: {0:C}'}" FontSize="18" TextColor="#1E3A8A" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar ao Cadastro" Clicked="OnVoltarClicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" HeightRequest="45" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
